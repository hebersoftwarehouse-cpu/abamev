---
import Page from '../layouts/Page.astro';
import { getPage } from '../data.server';
import { staticPaths } from '../../scripts/content.mjs';
import publications from '../../content/publications.json';
import pages from '../../content/pages.json';
import academics from '../../content/academics.json';
import boards from '../../content/boards.json';

export function getStaticPaths() {
  const paths = [...new Set([...staticPaths, ...publications, ...pages, ...academics, ...boards].map((item) => typeof item === 'string' ? item : item.path))];
  return paths.filter((path) => path !== '/').map((path) => ({
    params: { path: path.slice(1) },
    props: { data: getPage(path) },
  }));
}

const { data } = Astro.props;
---
<Page data={data} />
